/* Main screen styling */
Screen {
    background: #000000;
    color: #00ff00;
}

/* App grid layout */
#app-grid {
    layout: horizontal;
    height: 100%;
}

.left-panel {
    width: 30%;
    height: 1fr;
}

.right-panel {
    width: 70%;
    height: 1fr;
    layout: vertical;
}

/* Section title styling */
.section-title {
    background: #003300;
    color: #00ff00;
    padding: 1;
    text-align: center;
    width: 100%;
}

/* Spy name styling */
.spy-name {
    background: #003300;
    color: #00ff00;
    width: 100%;
    text-align: left;
    padding: 0 1;
}

.spy-name.selected {
    background: #00aa00;
    color: #000000;
    text-style: bold;
}

/* Spy selector */
#spy-selector {
    height: auto;
    max-height: 8;
    margin: 1 0;
    border: solid green;
}

/* Spy list */
.spy-list {
    height: 6;
    max-height: 6;
    border: none;
    overflow-y: auto;
}

/* Spy avatar */
.spy-avatar {
    background: #003300;
    color: white;
    min-width: 4;
    text-align: center;
    margin-right: 1;
}

/* Chat window container - takes remaining space */
#chat-window {
    height: 1fr;
    border: solid green;
    margin: 1 0;
    padding: 0 1;
    overflow-y: auto;
}

/* Ensure the chat window widget fills the container */
.chat-window-widget {
    height: 100%;
    width: 100%;
}

/* Input bar - fixed height at bottom */
#input-bar {
    height: auto;
    min-height: 3;
    border: solid green;
    padding: 1;
    margin: 0;
}

/* Message styling */
.message {
    margin: 1 0;
    padding: 0 1;
}

.message.user {
    text-align: right;
    color: #00ff00;
}

.message.assistant {
    text-align: left;
    color: #00aaff;
}

/* Status bar */
.status-bar {
    background: #003300;
    color: #00ff00;
    height: 1;
    padding: 0 1;
}
